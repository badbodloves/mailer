[Unit]
Description=Transactional Mailer Web UI
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/mailer/mailer
ExecStart=/home/mailer/mailer/venv/bin/python -m uvicorn transactional.web.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Berlin

[Install]
WantedBy=multi-user.target
